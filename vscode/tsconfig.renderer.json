{
  "compilerOptions": {
    "module": "ES2020",
    "target": "ES2020",
    "outDir": "out/renderer",
    "lib": ["ES2020", "DOM"],
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node"
  },
  "include": ["renderer/**/*.ts"]
}
