{
  "name": "copilot-notebook",
  "displayName": "Copilot Notebook",
  "description": "VS Code extension for Copilot SDK Jupyter kernel — prompt cells, context tracking, tool rendering",
  "version": "0.2.0",
  "publisher": "copilot-kernel",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Notebooks"
  ],
  "activationEvents": [
    "onNotebook:jupyter-notebook"
  ],
  "extensionDependencies": [
    "ms-toolsai.jupyter"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "copilot-prompt",
        "aliases": [
          "Prompt",
          "copilot-prompt"
        ],
        "extensions": [
          ".copilotprompt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "copilot-prompt",
        "scopeName": "source.markdown.copilot",
        "path": "./syntaxes/copilot.tmLanguage.json"
      }
    ],
    "notebookRenderer": [
      {
        "id": "copilot-output-renderer",
        "displayName": "Copilot Output Renderer",
        "entrypoint": "./out/renderer/renderer.js",
        "mimeTypes": [
          "text/html"
        ],
        "requiresMessaging": "optional"
      }
    ],
    "commands": [
      {
        "command": "copilot.addPromptCell",
        "title": "+ Prompt",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "copilot.pickModel",
        "title": "Copilot: Pick Model"
      },
      {
        "command": "copilot.toggleCellInclusion",
        "title": "Copilot: Toggle Inclusion"
      },
      {
        "command": "copilot.resetSession",
        "title": "Copilot: Reset Session"
      },
      {
        "command": "copilot.openBackendSetting",
        "title": "Open Backend Setting",
        "category": "Copilot",
        "icon": "$(server-process)"
      }
    ],
    "menus": {
      "notebook/toolbar": [
        {
          "command": "copilot.addPromptCell",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Copilot Notebook",
      "properties": {
        "copilotNotebook.backend": {
          "type": "string",
          "enum": ["copilot", "claude", "cursor"],
          "default": "copilot",
          "description": "Which agent backend executes prompt cells. 'copilot' uses the GitHub Copilot SDK with default credentials; per-cell picker offers GPT-5 mini (default) or GPT-5.5 with Medium/High/XHigh reasoning effort. 'claude' shells out to the `claude -p` CLI. 'cursor' shells out to the Cursor `agent -p` CLI."
        }
      }
    }
  },
  "scripts": {
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "css-loader": "^6.8.0",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.0-beta.4",
    "zod": "^4.4.3"
  }
}
