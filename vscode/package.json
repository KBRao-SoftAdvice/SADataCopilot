{
  "name": "claude-notebook",
  "displayName": "Claude Notebook",
  "description": "VS Code extension for Claude Code Jupyter kernel — prompt cells, context tracking, tool rendering",
  "version": "0.2.0",
  "publisher": "claude-kernel",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Notebooks"],
  "activationEvents": [
    "onNotebook:jupyter-notebook"
  ],
  "extensionDependencies": [
    "ms-toolsai.jupyter"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "claude-prompt",
        "aliases": ["Claude Prompt", "claude-prompt"],
        "extensions": [".claudeprompt"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "claude-prompt",
        "scopeName": "source.markdown.claude",
        "path": "./syntaxes/claude.tmLanguage.json"
      }
    ],
    "notebookRenderer": [
      {
        "id": "claude-output-renderer",
        "displayName": "Claude Output Renderer",
        "entrypoint": "./out/renderer/renderer.js",
        "mimeTypes": ["text/html"],
        "requiresMessaging": "optional"
      }
    ],
    "commands": [
      {
        "command": "claude.addPromptCell",
        "title": "+ Prompt",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claude.pickModel",
        "title": "Claude: Pick Model"
      },
      {
        "command": "claude.toggleCellInclusion",
        "title": "Claude: Toggle Inclusion"
      },
      {
        "command": "claude.resetSession",
        "title": "Claude: Reset Session"
      }
    ],
    "menus": {
      "notebook/toolbar": [
        {
          "command": "claude.addPromptCell",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.5.0",
    "css-loader": "^6.8.0",
    "style-loader": "^3.3.0"
  }
}
