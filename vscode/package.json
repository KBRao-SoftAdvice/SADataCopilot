{
  "name": "sadatacopilot",
  "displayName": "SADataCopilot",
  "description": "Notebook prompt cells with a shared Python kernel — supports GitHub Copilot, Claude, and Cursor agents.",
  "version": "0.2.2",
  "publisher": "SoftAdvice",
  "icon": "SAlogo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Notebooks"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KBRao-SoftAdvice/SADataCopilot.git",
    "directory": "vscode"
  },
  "license": "MIT",
  "activationEvents": [
    "onNotebook:jupyter-notebook"
  ],
  "extensionDependencies": [
    "ms-toolsai.jupyter"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "copilot-prompt",
        "aliases": [
          "Prompt",
          "copilot-prompt"
        ],
        "extensions": [
          ".copilotprompt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "copilot-prompt",
        "scopeName": "source.markdown.copilot",
        "path": "./syntaxes/copilot.tmLanguage.json"
      }
    ],
    "notebookRenderer": [
      {
        "id": "copilot-output-renderer",
        "displayName": "Copilot Output Renderer",
        "entrypoint": "./out/renderer/renderer.js",
        "mimeTypes": [
          "text/html"
        ],
        "requiresMessaging": "optional"
      }
    ],
    "commands": [
      {
        "command": "copilot.addPromptCell",
        "title": "+ Prompt",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "copilot.pickModel",
        "title": "SADataCopilot: Pick Model"
      },
      {
        "command": "copilot.toggleCellInclusion",
        "title": "SADataCopilot: Toggle Inclusion"
      },
      {
        "command": "copilot.resetSession",
        "title": "SADataCopilot: Reset Session"
      },
      {
        "command": "copilot.openBackendSetting",
        "title": "Open Backend Setting",
        "category": "SADataCopilot",
        "icon": "$(server-process)"
      }
    ],
    "menus": {
      "notebook/toolbar": [
        {
          "command": "copilot.addPromptCell",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "SADataCopilot",
      "properties": {
        "copilotNotebook.backend": {
          "type": "string",
          "enum": [
            "copilot",
            "claude",
            "cursor"
          ],
          "default": "copilot",
          "description": "Which agent backend executes prompt cells. 'copilot' uses the GitHub Copilot SDK with default credentials; per-cell picker offers GPT-5 mini (default) or GPT-5.5 with Medium/High/XHigh reasoning effort. 'claude' shells out to the `claude -p` CLI. 'cursor' shells out to the Cursor `agent -p` CLI."
        },
        "copilotNotebook.openaiApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional. If set (or `$OPENAI_API_KEY` is exported in the environment), the Copilot backend uses BYOK mode and routes model calls directly to `copilotNotebook.openaiBaseUrl` instead of GitHub Copilot's credential-backed endpoint. Matches the browser notebook's behavior."
        },
        "copilotNotebook.openaiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "markdownDescription": "Base URL for OpenAI-compatible BYOK requests. Used only when `copilotNotebook.openaiApiKey` (or `$OPENAI_API_KEY`) is present."
        }
      }
    }
  },
  "scripts": {
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "css-loader": "^6.8.0",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@github/copilot-sdk": "^1.0.0-beta.4"
  },
  "peerDependenciesMeta": {
    "@github/copilot-sdk": {
      "optional": true
    }
  }
}
